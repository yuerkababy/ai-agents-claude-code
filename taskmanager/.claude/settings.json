{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .claude/hooks/guard_writes.py",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "mcpServers": {
        "filesystem": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "C:/Users/georg/Documents/claude-projects/taskmanager"
            ]
        },
        "task-db": {
            "command": "node",
            "args": ["C:/Users/georg/Documents/claude-projects/pa7/task-db-server/index.js"]
        }
    }
}
